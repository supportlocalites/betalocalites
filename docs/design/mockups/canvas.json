 "notes": {
  "a-title": {
   "kind": "title1",
   "maxW": 4620,
   "page": "compare",
   "text": "A · Browse (round 1)",
   "w": 240,
   "x": 0,
   "y": -260
  },
  "a-why": {
   "fill": "teal",
   "page": "compare",
   "text": "A · Browse\nDiscovery first. Works like apps people already know: search bar on top, photo cards, bottom tabs.\nRound 1 covered Home, Search and Profile; the welcome page was added later.",
   "w": 380,
   "x": -460,
   "y": 0
  },
  "d-title": {
   "kind": "title1",
   "maxW": 4620,
   "page": "compare",
   "text": "D · Minimal luxury",
   "w": 240,
   "x": 0,
   "y": 2340
  },
  "d-why": {
   "fill": "gray",
   "page": "compare",
   "text": "D · Minimal luxury\nQuiet and exclusive: ivory ground, fine serif headlines, hairline rules, square black buttons, generous space. No bright colours, no rounded pills, no badges. Photography does the selling.",
   "w": 380,
   "x": -460,
   "y": 2600
  },
  "e-gap": {
   "fill": "gray",
   "page": "compare",
   "text": "E stops here. Conversation, Event plan, Mark as booked, How was it? and the vendor side were not built for E.",
   "w": 390,
   "x": 2350,
   "y": 1300
  },
  "e-title": {
   "kind": "title1",
   "maxW": 4620,
   "page": "compare",
   "text": "E · Between A and D: warm and refined",
   "w": 240,
   "x": 0,
   "y": 1040
  },
  "e-why": {
   "fill": "teal",
   "page": "compare",
   "text": "E · Between A and D\nFrom A: the familiar layout, search on top, the featured photo row, bottom tabs, friendly body text.\nFrom D: serif headlines, calm warm-white palette, hairlines, space.\nAdded warmth: one deep-teal accent, softly rounded corners and bubbles, personal wording.",
   "w": 380,
   "x": -460,
   "y": 1300
  },
  "f-sponsored": {
   "fill": "blue",
   "page": "compare",
   "text": "Featured row = paid placement, so it is labelled \"Featured\" with a Sponsored tag on each card, never \"Popular\". Search results stay unpaid and fairly ordered.",
   "w": 380,
   "x": -460,
   "y": 4460
  },
  "f-title": {
   "kind": "title1",
   "maxW": 4620,
   "page": "compare",
   "text": "F · D's colours, A's layout, a touch of gold",
   "w": 240,
   "x": 0,
   "y": 3640
  },
  "f-why": {
   "fill": "gray",
   "page": "compare",
   "text": "F · D's colours, A's layout\nColours from D: ivory ground, black ink and buttons, warm grey, stone photo tones.\nLayout from A: search bar on top, filter chips, the featured photo row, photo cards, bottom tabs, sticky Add to event / Message buttons.\nType: Playfair Display headlines, Jost for everything else.\nGold: only on a few lines and outlines, never on text.",
   "w": 380,
   "x": -460,
   "y": 3900
  },
  "sample": {
   "fill": "orange",
   "page": "compare",
   "text": "Sample content only. Every business, person, price, message and review here is made up.",
   "w": 380,
   "x": -460,
   "y": -260
  },
  "g-title": {
   "kind": "title1",
   "maxW": 4620,
   "page": "compare",
   "text": "G · F's look with D's planning screens",
   "x": 0,
   "y": 4940
  },
  "g-why": {
   "fill": "gray",
   "page": "compare",
   "w": 380,
   "x": -460,
   "y": 5200,
   "text": "G · F + D\nHome: D's calm layout with the search bar on top and the paid Featured row first.\nSearch and Profile: as F, with square photos.\nStart a conversation through to the vendor side: D's layouts in F's type, ivory, black buttons and gold lines.\nNavigation: tapping 'Localites' always returns to Home. Account sits top right on Home. The bottom bar has four tabs, like D. Back buttons appear only when there is somewhere to go back to."
  },
  "g-guests-title": {
   "kind": "title1",
   "maxW": 2270,
   "page": "compare",
   "text": "G · Invites, RSVPs & guest updates",
   "x": 4700,
   "y": 4940
  },
  "g-guests-why": {
   "fill": "blue",
   "page": "compare",
   "w": 380,
   "x": 7050,
   "y": 5200,
   "text": "Guests and invites\nGuests open the invite from a link: no account or app needed.\nThey see only the event name, time, place, the host's note and the RSVP date. Never vendors, budget, notes or other guests' replies.\nThe host sees every reply, the expected head-count, and who still needs a reminder.\nUpdates go to everyone or a chosen group (e.g. Going & Maybe). Guests can reply, and only the host sees replies."
  },
  "h-title": {
   "kind": "title1",
   "maxW": 4620,
   "page": "compare",
   "text": "H · Soft pastel: calm, with a touch of colour",
   "x": 0,
   "y": 6240
  },
  "h-guests-title": {
   "kind": "title1",
   "maxW": 2270,
   "page": "compare",
   "text": "H · Invites, RSVPs & guest updates",
   "x": 4700,
   "y": 6240
  },
  "h-why": {
   "fill": "green",
   "page": "compare",
   "w": 380,
   "x": -460,
   "y": 6500,
   "text": "H · Soft pastel\nInspired by your two screenshots: a warm blush background, white rounded cards, and a misty blue for the screens guests see.\nColour with meaning: sage = going, booked and main buttons; honey = maybe and star ratings; dusty rose = can't go; soft blue = information.\nType: DM Sans for reading, Source Serif for event names and the Localites name.\nSame screens and navigation rules as G: Localites returns to Home, Account top right, four bottom tabs."
  },
  "gd-title": {
   "kind": "title1",
   "maxW": 9040,
   "page": "compare",
   "text": "G on desktop: the same look on a computer screen",
   "x": 0,
   "y": 7540
  },
  "gd-why": {
   "fill": "gray",
   "page": "compare",
   "w": 380,
   "x": -460,
   "y": 7800,
   "text": "G on desktop\nThe same G style, laid out for a wide screen.\nThe phone's bottom tabs become a menu across the top, next to a wide search bar. Localites (top left) always returns to Home.\nWide screens show more side by side: filters beside results, the inbox + conversation + event details together, and the guest counts beside the vendor list.\nOpen any of these full-window to see them at real size; they also rearrange to fit narrower windows."
  }
 },
