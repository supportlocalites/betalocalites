{
  // Cloudflare Workers, free plan (ADR-007). Secrets such as DATABASE_URL are set in
  // the Cloudflare dashboard by the product owner, never in this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localites",
  // The Worker's entry point. `npm run build` (React Router + Cloudflare's Vite plugin)
  // bundles it with the pages and puts the browser files alongside as static assets.
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Suggest a business (ADR-027): at most 3 suggestions a minute from one internet
  // address. Cloudflare counts in memory and forgets; addresses are never stored.
  "ratelimits": [
    { "name": "SUGGEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    // Sign in with an emailed code (ADR-028): 10 code requests or code checks a minute per address.
    { "name": "SIGN_IN_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    // Owners saving their listing (D-34, ADR-029): 10 saves a minute per person.
    { "name": "OWNER_EDIT_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    // Browsers reporting what was on screen (ADR-030): 60 reports a minute per address.
    { "name": "TRACK_LIMIT", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    // New visitor cookies with a page that counts (ADR-030): 20 a minute per address.
    { "name": "NEW_VISITOR_LIMIT", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
    // Planning an event (slice 2A): 30 changes a minute per person (events, plans, saves, flags).
    { "name": "PLAN_LIMIT", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } },
    // Business photos (E §9): 20 changes a minute per person (adding 8 photos and describing them fits).
    { "name": "PHOTO_EDIT_LIMIT", "namespace_id": "1007", "simple": { "limit": 20, "period": 60 } },
    // Guests' replies to invitations: per internet address, per minute (E §5).
    { "name": "INVITE_LIMIT", "namespace_id": "1008", "simple": { "limit": 20, "period": 60 } }
  ],
  // The team's daily note of owners' changes (ADR-029) and the nightly count of activity
  // (ADR-030), free on Cloudflare: 12:00 UTC is 8 am in Toronto in summer and 7 am in
  // winter; the 14:00 run only retries what failed.
  "triggers": { "crons": ["0 12 * * *", "0 14 * * *"] },
  // Public settings (not secrets). SITE_URL: where links in scheduled emails point.
  // PHOTO_REGION: the Supabase project's storage region, for business photos (PO-16).
  "vars": { "PHOTO_REGION": "ca-central-1", "SITE_URL": "https://localites.supportlocalites.workers.dev" },
  // Cloudflare Hyperdrive (free): the app's route to Supabase. It keeps the encrypted
  // connection to the database (SSL "require") and pools connections. The ID is not a
  // secret; the database login lives only in Cloudflare. localConnectionString is a
  // placeholder for local emulation only (Cloudflare's publish step requires one); it
  // has no password and is never used by the live site. Override it for local runs
  // with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4e3e6b64b1cb4015a679dd85ad7a8daa",
      "localConnectionString": "postgres://postgres@localhost:5432/localites_dev"
    }
  ]
}
