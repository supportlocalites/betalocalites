{
  // Cloudflare Workers, free plan (ADR-007). Secrets such as DATABASE_URL are set in
  // the Cloudflare dashboard by the product owner, never in this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localites",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Cloudflare Hyperdrive (free): the app's route to Supabase. It keeps the encrypted
  // connection to the database (SSL "require") and pools connections. The ID is not a
  // secret; the database login lives only in Cloudflare. For `wrangler dev`, set
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE to a local database.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "4e3e6b64b1cb4015a679dd85ad7a8daa" }]
}
