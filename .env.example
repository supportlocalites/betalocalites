# Copy to .env for local development (`npm run dev` / `npm run preview`). Never commit
# real values. The app reaches the database through the HYPERDRIVE link (wrangler.jsonc);
# on your computer this points it at a local database instead, as the restricted
# app_server role (ADR-004).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://app_server:local-dev-only@localhost:5434/localites_dev
