{
  "name": "localites",
  "version": "0.1.0",
  "private": true,
  "description": "Localites: local event vendors, found and contacted directly. Orillia, Ontario.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "react-router typegen && tsc",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:words": "node scripts/check-words.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:tokens && npm run check:words",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "node tests/e2e/admin-access.mjs && node tests/e2e/claiming.mjs && node tests/e2e/human-check.mjs && node tests/e2e/owner-editing.mjs && node tests/e2e/analytics.mjs && node tests/e2e/event-plans.mjs",
    "size": "node scripts/worker-size.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed:test": "node scripts/seed-test-data.mjs",
    "db:import:test-businesses": "node scripts/import-test-businesses.mjs",
    "db:types": "node scripts/db-types.mjs"
  },
  "dependencies": {
    "@fontsource/jost": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "drizzle-orm": "0.45.4",
    "isbot": "5.2.2",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261010.1",
    "@eslint/js": "9.37.0",
    "@react-router/dev": "8.4.0",
    "@types/node": "22.18.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
